# ------------------------------------------------------------------------------
# DevOrbit Terraform variables template
# Copy this file to terraform.tfvars and replace the placeholders.
# NEVER commit terraform.tfvars or private keys to Git.
# ------------------------------------------------------------------------------

aws_region   = "ap-south-1"
project_name = "devorbit"
environment  = "dev"

# Add one /32 entry per administrator (all three team members).
# Restrict SSH, Jenkins, Grafana and Prometheus before running apply.
# allowed_ssh_cidrs = [
#   "203.0.113.10/32", # Member 1
#   "198.51.100.20/32", # Member 2
#   "192.0.2.30/32",    # Member 3
# ]
# allowed_admin_cidrs = [
#   "203.0.113.10/32",
#   "198.51.100.20/32",
#   "192.0.2.30/32",
# ]

# Required: only reviewers' or the college network's CIDRs may access the
# application NodePort. Public internet access (0.0.0.0/0) is forbidden.
allowed_app_cidrs = [
  "203.0.113.10/32", # Reviewer / Member 1
  "198.51.100.20/32", # Reviewer / Member 2
  "192.0.2.30/32",    # Reviewer / Member 3
]

# Optional: subscribe this address to CloudWatch CPU alarms.
alarm_email = ""

# Paste your SSH public key content here so Ansible can connect.
# ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... user@machine"

instance_types = {
  bastion = "t3.micro"
  jenkins = "t3.medium"
  app     = "t3.medium"
}

root_volume_size_gb = {
  bastion = 10
  jenkins = 30
  app     = 30
}

enable_bastion      = true
ecr_repository_name = "devorbit-app"

# Read-only console + Session Manager IAM users for teammates.
# The map key is the IAM user name; replace the placeholder e-mail addresses.
# Passwords are created separately with the AWS CLI (never stored here).
teammate_iam_users = {
  teammate-two   = { email = "teammate.two@example.com" }
  teammate-three = { email = "teammate.three@example.com" }
}
