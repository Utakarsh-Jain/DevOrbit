#!/bin/bash
# Managed by Ansible (roles/k3s). Renews the ECR pull secret used by the
# DevOrbit Deployment. ECR login tokens expire after 12 hours and Jenkins only
# refreshes the secret on deploy, so new Pods (scale-up, self-healing) would
# fail with 403 Forbidden without this job. Uses the node IAM role; no keys.
set -euo pipefail
REGION={{ aws_region }}
NAMESPACE={{ k8s_namespace }}
ACCOUNT_ID=$(/usr/bin/aws sts get-caller-identity --query Account --output text)
REGISTRY="${ACCOUNT_ID}.dkr.ecr.${REGION}.amazonaws.com"
/usr/local/bin/k3s kubectl -n "$NAMESPACE" create secret docker-registry ecr-registry-secret \
  --docker-server="$REGISTRY" --docker-username=AWS \
  --docker-password="$(/usr/bin/aws ecr get-login-password --region "$REGION")" \
  --dry-run=client -o yaml | /usr/local/bin/k3s kubectl apply -f -
echo "$(date -u +%FT%TZ) ecr-registry-secret refreshed"
