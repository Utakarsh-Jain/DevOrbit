# ------------------------------------------------------------------------------
# DevOrbit Ansible inventory template
#
# Copy this file to hosts.ini and paste the Terraform output values:
#   terraform output ansible_inventory
#
# All three hosts live in separate, peered AWS VPCs. Ansible runs from
# AWS CloudShell or the bastion host (VPC-A), never from a local machine.
# ------------------------------------------------------------------------------

[bastion]
devorbit-bastion ansible_host=BASTION_PUBLIC_IP

[jenkins]
devorbit-jenkins ansible_host=JENKINS_PUBLIC_IP

[k3s]
devorbit-k3s ansible_host=K3S_PUBLIC_IP

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/devorbit-key.pem
ansible_python_interpreter=/usr/bin/python3
