# Generate these values from: terraform -chdir=terraform output ansible_inventory
[bastion]
# BASTION_PUBLIC_IP ansible_user=ubuntu

[jenkins]
# JENKINS_PUBLIC_IP ansible_user=ubuntu

[k3s]
# K3S_PUBLIC_IP ansible_user=ubuntu

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/devorbit-key.pem
ansible_python_interpreter=/usr/bin/python3
