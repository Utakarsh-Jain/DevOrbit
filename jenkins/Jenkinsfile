pipeline {
    agent any

    environment {
        PIPELINE_CONFIG = '/etc/devorbit/pipeline.env'
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                // Built-in Pipeline step: avoids depending on the optional
                // Workspace Cleanup plugin during the first CI bootstrap.
                deleteDir()
                checkout scm
                script {
                    def values = sh(script: '''
                        set -eu
                        test -r "$PIPELINE_CONFIG"
                        . "$PIPELINE_CONFIG"
                        for value in "$AWS_REGION" "$ECR_REPOSITORY" "$K8S_NAMESPACE" "$K8S_DEPLOYMENT" "$K3S_NODE_IP" "$K3S_NODE_PORT" "$KUBECONFIG_CRED"; do
                            test -n "$value"
                            printf '%s\\n' "$value"
                        done
                    ''', returnStdout: true).trim().split('\\n')
                    if (values.size() != 7) {
                        error('Invalid /etc/devorbit/pipeline.env: expected seven non-empty values.')
                    }
                    env.AWS_REGION = values[0]
                    env.ECR_REPOSITORY = values[1]
                    env.IMAGE_NAME = values[1]
                    env.K8S_NAMESPACE = values[2]
                    env.K8S_DEPLOYMENT = values[3]
                    env.K3S_NODE_IP = values[4]
                    env.K3S_NODE_PORT = values[5]
                    env.KUBECONFIG_CRED = values[6]
                    // The checked-out Git SHA is the immutable release identity.
                    def sha = sh(script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                    echo "==> Stage 1: checked out ${env.BRANCH_NAME ?: 'main'} at ${sha}"
                    echo "==> Image tag for this build: ${sha}"
                }
            }
        }

        stage('Build') {
            steps {
                dir('app') {
                    echo "==> Stage 2: Compiling Java source code with Maven..."
                    sh 'mvn -B -ntp clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('app') {
                    echo "==> Stage 3: Running automated tests. A failure stops the pipeline."
                    sh 'mvn -B -ntp test'
                }
            }
            post {
                always {
                    junit testResults: 'app/target/surefire-reports/*.xml', allowEmptyResults: true
                }
            }
        }

        stage('Package') {
            steps {
                dir('app') {
                    echo "==> Stage 4: Packaging the application JAR..."
                    sh 'mvn -B -ntp package -DskipTests'
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('app') {
                    echo "==> Stage 5: Building the container image (frontend + backend + JAR)..."
                    sh '''
                        set -eu
                        . "$PIPELINE_CONFIG"
                        IMAGE_TAG=$(git rev-parse --short=7 HEAD)
                        docker build -t "${ECR_REPOSITORY}:${IMAGE_TAG}" .
                    '''
                }
            }
        }

        stage('Docker Push') {
            steps {
                echo "==> Stage 6: Pushing the image to Amazon ECR using the EC2 IAM role..."
                sh '''
                    set -e
                    . "$PIPELINE_CONFIG"
                    IMAGE_TAG=$(git rev-parse --short=7 HEAD)
                    AWS_ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
                    ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
                    aws ecr get-login-password --region "${AWS_REGION}" \
                        | docker login --username AWS --password-stdin "${ECR_REGISTRY}"
                    docker tag "${ECR_REPOSITORY}:${IMAGE_TAG}" "${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"
                    docker push "${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"
                    echo "${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}" > image-ref.txt
                '''
                stash name: 'image-ref', includes: 'image-ref.txt'
            }
        }

        stage('Deploy') {
            steps {
                echo "==> Stage 7: Deploying the new version to Kubernetes..."
                withCredentials([file(credentialsId: "${env.KUBECONFIG_CRED}", variable: 'KUBECONFIG_FILE')]) {
                    sh '''
                        set -e
                        . "$PIPELINE_CONFIG"
                        IMAGE_TAG=$(git rev-parse --short=7 HEAD)
                        export KUBECONFIG="$KUBECONFIG_FILE"
                        AWS_ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
                        ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
                        IMAGE="${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"

                        kubectl apply -f k8s/namespace.yaml
                        kubectl apply -f k8s/configmap.yaml

                        # The ECR token is short lived, so the pull secret is refreshed on every deploy.
                        kubectl create secret docker-registry ecr-registry-secret \
                            --docker-server="${ECR_REGISTRY}" \
                            --docker-username=AWS \
                            --docker-password="$(aws ecr get-login-password --region ${AWS_REGION})" \
                            -n "${K8S_NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f -

                        sed "s#IMAGE_PLACEHOLDER#${IMAGE}#g" k8s/deployment.yaml | kubectl apply -f -
                        kubectl apply -f k8s/service.yaml

                        # Prometheus + Grafana for application metrics (JVM, HTTP).
                        kubectl apply -f k8s/monitoring.yaml

                        # Visible in kubectl rollout history for the demo.
                        kubectl annotate deployment/${K8S_DEPLOYMENT} -n "${K8S_NAMESPACE}" \
                            kubernetes.io/change-cause="Deployed ${IMAGE}" --overwrite
                    '''
                }
            }
        }

        stage('Verify') {
            steps {
                echo "==> Stage 8: Verifying rollout and application health..."
                withCredentials([file(credentialsId: "${env.KUBECONFIG_CRED}", variable: 'KUBECONFIG_FILE')]) {
                    sh '''
                        set -e
                        export KUBECONFIG="$KUBECONFIG_FILE"
                        kubectl rollout status deployment/${K8S_DEPLOYMENT} -n "${K8S_NAMESPACE}" --timeout=180s
                        kubectl wait --for=condition=Ready pod -l app=${K8S_DEPLOYMENT} -n "${K8S_NAMESPACE}" --timeout=120s
                        kubectl get pods,svc -n "${K8S_NAMESPACE}" -o wide
                        echo "Running image:"
                        kubectl get deployment ${K8S_DEPLOYMENT} -n "${K8S_NAMESPACE}" \
                            -o jsonpath='{.spec.template.spec.containers[0].image}{"\\n"}'

                        if [ -n "${K3S_NODE_IP}" ]; then
                            health_ok=0
                            for i in 1 2 3 4 5; do
                                if curl -fsS --max-time 5 "http://${K3S_NODE_IP}:${K3S_NODE_PORT}/health"; then
                                    health_ok=1
                                    echo ""
                                    echo "Application /health responded successfully."
                                    break
                                fi
                                echo "Health check attempt ${i} failed, retrying..."
                                sleep 10
                            done
                            if [ "${health_ok}" -ne 1 ]; then
                                echo "Application /health did not respond after 5 attempts."
                                exit 1
                            fi
                            echo "Application root endpoint:"
                            curl -fsS --max-time 5 "http://${K3S_NODE_IP}:${K3S_NODE_PORT}/" || true
                            echo ""
                        else
                            echo "K3S_NODE_IP is empty, skipping the external /health check."
                        fi
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "==========================================================="
            echo "DevOrbit CI/CD pipeline succeeded."
            echo "Deployed commit: ${env.GIT_COMMIT ?: 'see Jenkins build log'}"
            echo "Verify the version at the application root endpoint."
            echo "==========================================================="
        }
        failure {
            echo "==========================================================="
            echo "DevOrbit CI/CD pipeline failed. Deployment was not promoted."
            echo "The previous ReplicaSet keeps serving traffic."
            echo "Manual rollback: kubectl rollout undo deployment/${env.K8S_DEPLOYMENT} -n ${env.K8S_NAMESPACE}"
            echo "==========================================================="
        }
    }
}
